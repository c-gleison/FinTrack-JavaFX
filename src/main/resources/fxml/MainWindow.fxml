<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>  
<?import javafx.scene.layout.Region?>

<?import javafx.scene.text.Text?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>


<StackPane xmlns:fx="http://javafx.com/fxml" stylesheets="@../css/style.css" fx:controller="com.cg.fintrackgui.controller.MainWindowController">
    <BorderPane fx:id="mainBorderPane" styleClass="default-background">
        <padding>
            <Insets bottom="0.0" left="0.0" right="0.0" top="0.0"/>
        </padding>
        <top>
            <VBox alignment="CENTER" spacing="0.0">
                <padding>
                    <Insets bottom="0.0" left="0.0" right="0.0" top="0.0"/>
                </padding>

                <MenuBar visible="false" managed="false"> 
                    <menus>
                        <Menu text="File">
                            <items>
                                <MenuItem text="Open"/>
                            </items>
                            <items>
                                <MenuItem text="Exit"/>
                            </items>
                        </Menu>
                    </menus>
                    <menus>
                        <Menu text="Help">
                            <items>
                                <MenuItem text="About"/>
                            </items>
                        </Menu>
                    </menus>
                </MenuBar> 
            </VBox>
   
        </top>
        <left>
            <VBox styleClass="ctn-sidebar" minWidth="40" maxWidth="40">
            </VBox>
        </left>
        <center>
            <VBox spacing="1.0">
                <padding>
                    <Insets top="5.0" right="5.0" left="5.0" bottom="5.0" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="20" maxHeight="60">
                    <VBox.margin>
                        <Insets bottom="20.0"/>
                    </VBox.margin>
   
                    <HBox alignment="CENTER_LEFT" spacing="10" minWidth="150" styleClass="default-container, ctn-bg-blue-00" >
                        <StackPane alignment="CENTER" styleClass="default-container, ctn-bg-blue-01" maxHeight="30" maxWidth="30">
                            <Text text="&#xf555;" styleClass="icon-fa, icon-sz-big, text-blue-03"/>   
                        </StackPane>

                        <VBox alignment="CENTER_LEFT">
                            <Label text="Saldo Total" styleClass="default-text, txt-blue-0"/>
                            <Label fx:id="txtBalance" text="R$ 0" styleClass="default-text, txt-sz-big, txt-bold,"/>
                        </VBox>
                    </HBox>
                </HBox> 

                <HBox styleClass="" minHeight="35" maxHeight="35" alignment="CENTER_LEFT" spacing="3">      
                    <Button text="Nova Transação" minWidth="130" styleClass="default-button, btn-blue" onAction="#addTransaction"> <graphic> <Text text="&#xf067;" styleClass="icon-fa, txt-white" /> </graphic> </Button>
                    <Region  HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnUpd" text="" maxWidth="20" styleClass="default-button, btn-green" onAction="#updateTransaction"> <graphic> <Text text="&#xf040;" styleClass="icon-fa, txt-white"/> </graphic> </Button>
                    <Button fx:id="btnRm" text="" maxWidth="20" styleClass="default-button, btn-red" onAction="#removeTransaction"> <graphic> <Text text="&#xf014;" styleClass="icon-fa, txt-white" /> </graphic> </Button>
                </HBox>  

                <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS" styleClass="table-view" focusTraversable="false">
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <columns>
                        <TableColumn fx:id="colId" text="ID" minWidth="40" maxWidth="40" resizable="false" styleClass="" sortable="false" reorderable="false" />
                        <TableColumn fx:id="colName" text="Nome" minWidth="60" maxWidth="60" styleClass="" reorderable="false"/>
                        <TableColumn fx:id="colValue" text="Valor" minWidth="60" maxWidth="100" resizable="true" styleClass="" reorderable="false"/>
                        <TableColumn fx:id="colType" text="Tipo" minWidth="60" maxWidth="60" resizable="false" styleClass="centered-column" reorderable="false"/>
                        <TableColumn fx:id="colDate" text="Data" minWidth="80" maxWidth="80" resizable="false" styleClass="centered-column" reorderable="true"/>
                        <TableColumn fx:id="colMonth" text="Recorrência" minWidth="80" maxWidth="80" resizable="false" styleClass="centered-column" reorderable="true"/>
                        <TableColumn fx:id="colDescription" text="Descrição" minWidth="60" reorderable="false" sortable="false"/>
                    </columns>                       
                </TableView>
            </VBox>
        </center>
        <bottom>
        </bottom>

    </BorderPane>

    <StackPane fx:id="overlayPane" visible="false" style="-fx-background-color: rgba(0, 0, 0, 0.2);" />

</StackPane>
