<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Region?>




<VBox prefWidth="480.0" prefHeight="360.0" stylesheets="@../css/style.css" xmlns:fx="http://javafx.com/fxml" fx:controller="com.cg.fintrackgui.controller.NewTransactionWindowController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>

    <VBox spacing="3">
        <Label text="Adicionar nova transação" styleClass="app-title" alignment="CENTER"/>
        <Separator/>

        <Label text="Descrição da transação:"/>
        <TextArea fx:id="TxtDescription" promptText="Digite os detalhes aqui..." prefRowCount="4" wrapText="true"/>
        <Separator/>

        <HBox spacing="5">
            
            <VBox spacing="5">
                <Label text="Recorrência:"/>
                <HBox spacing="5">
                    <padding>
                        <Insets top="3"/>
                    </padding>
                    <CheckBox fx:id="" text="SIM" />
                    <CheckBox fx:id="" text="NÃO" />  
                </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <VBox spacing="5" alignment="CENTER_RIGHT">
                <Label text="Valor:"/>
                <TextField fx:id="TxtValue" promptText="R$" maxWidth="80"/>
            </VBox>

        </HBox>
    </VBox>

</VBox>

